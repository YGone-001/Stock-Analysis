<hc:Window x:Class="AIHelper.Views.SparrowWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="选股任务" Height="600" Width="800"
           WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar / Settings -->
        <GroupBox Header="选股参数设置" Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel>
                <CheckBox x:Name="ChkMacroDef" Content="使用宏定义过滤" Margin="0,0,15,10"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                    <TextBlock Text="最小涨幅:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <hc:NumericUpDown x:Name="NumMinRise" Minimum="-20" Maximum="20" Value="2" Width="80"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                    <TextBlock Text="最大涨幅:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <hc:NumericUpDown x:Name="NumMaxRise" Minimum="-20" Maximum="20" Value="8" Width="80"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                    <TextBlock Text="量比 >=" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <hc:NumericUpDown x:Name="NumVolRatio" Minimum="0" Maximum="100" Value="1.5" Width="80" Increment="0.1"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                    <TextBlock Text="最小成交额(亿):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <hc:NumericUpDown x:Name="NumMinAmount" Minimum="0" Maximum="10000" Value="1" Width="80"/>
                </StackPanel>
                
                <CheckBox x:Name="ChkMA60" Content="站上60日均线" Margin="0,0,15,10"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                    <TextBlock Text="均线粘合度(%)" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <hc:RangeSlider x:Name="SldAdhesion" Minimum="0" Maximum="10" ValueStart="0" ValueEnd="3" Width="120" VerticalAlignment="Center"/>
                </StackPanel>
                
                <CheckBox x:Name="ChkUseCache" Content="使用缓存数据" Margin="0,0,15,10" IsChecked="True"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                    <TextBlock Text="并发数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <hc:NumericUpDown x:Name="NumConcurrency" Minimum="1" Maximum="20" Value="5" Width="70"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>
        
        <!-- Logs -->
        <GroupBox Header="运行日志" Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="TxtLog" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" Background="#F9F9F9"/>
        </GroupBox>
        
        <!-- Progress and Action -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtProgressDesc" Text="准备就绪" Margin="0,0,0,5"/>
                <ProgressBar x:Name="PbScan" Height="15" Margin="0,0,10,5"/>
                <TextBlock x:Name="TxtStats" Text="统计: 0 / 0" Foreground="Gray"/>
            </StackPanel>
            
            <Button x:Name="BtnStart" Grid.Column="1" Content="开始执行" Width="100" Height="40" 
                    Style="{StaticResource ButtonPrimary}"/>
        </Grid>
    </Grid>
</hc:Window>
