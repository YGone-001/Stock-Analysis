<hc:Window x:Class="AIHelper.Views.SparrowWindowDC"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="麻雀策略" Width="940" Height="800" MinWidth="820" MinHeight="640">
  <hc:Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </hc:Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="策略模式" Width="88" VerticalAlignment="Center"/>
          <ComboBox x:Name="StrategyModeSelector" Width="180" MinHeight="28"
                    DisplayMemberPath="DisplayName" SelectedValuePath="Mode"
                    ItemsSource="{Binding AvailableStrategyModeOptions}"
                    SelectedValue="{Binding StrategyMode, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding ShowPairComparison, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="对照组" Width="88" VerticalAlignment="Center"/>
          <TextBlock Text="两侧各自使用已保存参数" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <ComboBox Width="220" MinHeight="28" DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding AvailablePairComparisonPresets}"
                    SelectedItem="{Binding SelectedPairComparisonPreset, Mode=TwoWay}"/>
        </StackPanel>

        <TextBlock Text="{Binding StrategyDescription}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>

        <GroupBox Header="{Binding BaseParametersHeader}" Margin="0,0,0,8" Padding="8">
          <StackPanel>
            <TextBlock Text="市场与资金" FontWeight="SemiBold" Margin="0,2,0,6"/>
            <WrapPanel>
              <CheckBox x:Name="ChkMacroDef" Content="大盘防守" ToolTip="按当前策略定义检查市场环境。" Margin="0,0,15,10"
                        IsChecked="{Binding Parameters.MacroDef, Mode=TwoWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,15,10" ToolTip="最低/最高当日涨幅；用于排除未启动或过度追高标的。">
                <TextBlock Text="涨幅范围（%）：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown x:Name="NumMinRise" Minimum="-20" Maximum="20" Width="65" ToolTip="最低当日涨幅；提高会减少未启动标的。"
                                  Value="{Binding Parameters.MinRise, Mode=TwoWay}"/>
                <TextBlock Text=" — " VerticalAlignment="Center"/>
                <hc:NumericUpDown x:Name="NumMaxRise" Minimum="-20" Maximum="20" Width="65" ToolTip="最高当日涨幅；降低可减少追高标的。"
                                  Value="{Binding Parameters.MaxRise, Mode=TwoWay}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,15,10" ToolTip="最低成交额，单位万元。">
                <TextBlock Text="最低成交额（万元）：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown x:Name="NumMinAmount" Minimum="0" Maximum="1000000" Width="90"
                                  Value="{Binding Parameters.MinAmount, Mode=TwoWay}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,15,10" ToolTip="要求外盘 &gt; 内盘 × 此比例。">
                <TextBlock Text="外盘 / 内盘比：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown x:Name="NumVolRatio" Minimum="0" Maximum="100" Width="75" Increment="0.1"
                                  Value="{Binding Parameters.VolRatio, Mode=TwoWay}"/>
              </StackPanel>
            </WrapPanel>

            <TextBlock Text="趋势结构" FontWeight="SemiBold" Margin="0,2,0,6"/>
            <StackPanel>
              <CheckBox x:Name="ChkMA60" Content="MA60 趋势确认" ToolTip="要求价格与 MA20 满足当前策略的 MA60 趋势条件。" Margin="0,0,15,10"
                        IsChecked="{Binding Parameters.CheckMA60, Mode=TwoWay}"/>
              <StackPanel Margin="0,2,15,10">
                <TextBlock Text="均线黏合度（%）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <hc:NumericUpDown x:Name="NumMinAdhesion" Minimum="0" Maximum="15" Increment="0.1" Width="65" VerticalAlignment="Center"
                                    ToolTip="最低均线黏合度（%）；通常为 0.0%。"
                                    Value="{Binding Parameters.MinAdhesion, Mode=TwoWay}"/>
                  <hc:RangeSlider x:Name="SldAdhesion" Minimum="0" Maximum="15" SmallChange="0.1" TickFrequency="0.5" Width="160"
                                  VerticalAlignment="Center" Margin="8,0,8,0"
                                  ToolTip="MA5/MA10/MA20 最大离散程度；越低代表均线越紧。"
                                  ValueStart="{Binding Parameters.MinAdhesion, Mode=TwoWay}"
                                  ValueEnd="{Binding Parameters.MaxAdhesion, Mode=TwoWay}"/>
                  <hc:NumericUpDown x:Name="NumMaxAdhesion" Minimum="0" Maximum="15" Increment="0.1" Width="65" VerticalAlignment="Center"
                                    ToolTip="最高均线黏合度（%）；越小越紧，推荐上限 4.0%。"
                                    Value="{Binding Parameters.MaxAdhesion, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Foreground="DimGray" VerticalAlignment="Center" Text="{Binding AdhesionRangeText}"/>
                  <TextBlock Text="越小 = 均线越紧；推荐上限 4.0%" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="{Binding V2ParametersHeader}" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding ShowV2Parameters, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Margin="0,2,15,10">
              <TextBlock Text="换手率范围（%）" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <hc:NumericUpDown x:Name="NumMinTurnover" Minimum="0" Maximum="50" Increment="0.5" Width="65" VerticalAlignment="Center"
                                  ToolTip="最低当日换手率（%）；推荐 3.0%。"
                                  Value="{Binding EnhancementParameters.MinTurnover, Mode=TwoWay}"/>
                <hc:RangeSlider x:Name="SldTurnover" Minimum="0" Maximum="50" SmallChange="0.5" TickFrequency="5.0" Width="160"
                                VerticalAlignment="Center" Margin="8,0,8,0" ToolTip="仅 V2：换手率范围（%）。"
                                ValueStart="{Binding EnhancementParameters.MinTurnover, Mode=TwoWay}"
                                ValueEnd="{Binding EnhancementParameters.MaxTurnover, Mode=TwoWay}"/>
                <hc:NumericUpDown x:Name="NumMaxTurnover" Minimum="0" Maximum="50" Increment="0.5" Width="65" VerticalAlignment="Center"
                                  ToolTip="最高当日换手率（%）；推荐 30.0%。"
                                  Value="{Binding EnhancementParameters.MaxTurnover, Mode=TwoWay}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Foreground="DimGray" VerticalAlignment="Center" Text="{Binding TurnoverRangeText}"/>
                <TextBlock Text="推荐：3.0% ~ 30.0%" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <WrapPanel>
              <CheckBox x:Name="ChkAlpha" Content="Alpha 基准确认" ToolTip="仅 V2：要求个股当日表现不弱于上证基准。" Margin="0,0,15,10"
                        IsChecked="{Binding EnhancementParameters.CheckAlpha, Mode=TwoWay}"/>
              <CheckBox x:Name="ChkStrictTurnover" Content="换手率缺失即淘汰" ToolTip="仅 V2：换手率数据缺失或非正时直接淘汰；关闭则按历史策略放行。" Margin="0,0,15,10"
                        IsChecked="{Binding EnhancementParameters.StrictTurnover, Mode=TwoWay}"/>
              <CheckBox x:Name="ChkSectorHeat" Content="板块热度加成" ToolTip="V2 家族：按所属行业板块当日涨幅百分位加成排名（Rank-V2 profile）；数据不可用时自动回退且不改变入选资格。" Margin="0,0,15,10"
                        IsChecked="{Binding EnhancementParameters.SectorHeatEnabled, Mode=TwoWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,15,10" ToolTip="仅 V2：MA5 当前值相对前一窗口的动量阈值。">
                <TextBlock Text="MA5 动量阈值：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown x:Name="NumMomentum" Minimum="0" Maximum="100" Width="75" Increment="0.01"
                                  Value="{Binding EnhancementParameters.MomentumThreshold, Mode=TwoWay}"/>
                <TextBlock Text="当前规则：Momentum 必须严格 &gt; 该值" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="V3 动量门限" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding ShowV3Parameters, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="RSI(14) 区间：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <hc:NumericUpDown x:Name="NumRsiMin" Minimum="0" Maximum="100" Increment="1" Width="65"
                                Value="{Binding MomentumGateParameters.RsiMin, Mode=TwoWay}"/>
              <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0,4,0"/>
              <hc:NumericUpDown x:Name="NumRsiMax" Minimum="0" Maximum="100" Increment="1" Width="65"
                                Value="{Binding MomentumGateParameters.RsiMax, Mode=TwoWay}"/>
              <TextBlock Text="0~100 等效关闭该门限" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="MACD 多头要求（DIF ≥ DEA）：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <CheckBox x:Name="ChkMacdBullish" Margin="0,0,15,0"
                        IsChecked="{Binding MomentumGateParameters.RequireMacdBullish, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="V3 = 冻结的 V2 规则 + 以上动量门限；门限在 V2 全部通过后才评估。" Foreground="Gray" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="V4 量价形态" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding ShowV4Parameters, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="启用量价门限：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <CheckBox x:Name="ChkVolumeGates"
                        IsChecked="{Binding VolumeGateParameters.VolumeGatesEnabled, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="放量突破倍数（当日量 / 近5日均量）：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <hc:NumericUpDown x:Name="NumVolBreakout" Minimum="0.1" Maximum="10" Increment="0.1" Width="65"
                                Value="{Binding VolumeGateParameters.VolBreakoutMultiple, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="缩量蓄势比（近5日均量 / 基期10日均量）：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <hc:NumericUpDown x:Name="NumVolContraction" Minimum="0.1" Maximum="2" Increment="0.05" Width="65"
                                Value="{Binding VolumeGateParameters.VolContractionMaxRatio, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="V4 = 冻结的 V3 规则 + 量价形态门限；量数据缺失时该股显式记为数据不可用。" Foreground="Gray" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="V5 周线共振" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding ShowV5Parameters, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="要求周线 MA20 趋势向上：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <CheckBox x:Name="ChkWeeklyUptrend"
                        IsChecked="{Binding WeeklyGateParameters.RequireWeeklyUptrend, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="V5 = 冻结的 V4 规则 + 周线共振；按日历周重采样（周收盘=每周最后交易日收盘），历史不足 21 周时该股显式记为数据不可用。" Foreground="Gray" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="V6 分钟回踩（仅实盘）" Margin="0,0,0,8" Padding="8"
                  Visibility="{Binding ShowV6Parameters, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="启用分钟回踩确认：" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <CheckBox x:Name="ChkIntradayGate"
                        IsChecked="{Binding V6Parameters.IntradayGateEnabled, Mode=TwoWay}"/>
              <TextBlock Text="分钟 MA 周期：" VerticalAlignment="Center" Margin="10,0,5,0"/>
              <hc:NumericUpDown x:Name="NumIntradayMa" Minimum="1" Maximum="30" Increment="1" Width="65"
                                Value="{Binding V6Parameters.IntradayMaPeriod, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="V6 = 冻结的 V5 规则 + 分钟级回踩确认；仅实盘可用——日线全部门限通过后，对幸存者拉取 30/60 分钟 K 线并要求最新分钟收盘站上其均线。历史回放不支持该门限。" Foreground="Gray" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>

        <TextBlock Text="{Binding ComparisonHint}" Foreground="SteelBlue" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisibility}}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="最终精选：" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
          <!-- Literal bounds mirror SparrowRankingSettings.Minimum/MaximumTopN; the code-behind re-applies the constants. -->
          <hc:NumericUpDown x:Name="NumTopN" Minimum="1" Maximum="20" Width="65" Increment="1"
                            ToolTip="最终输出数量（1～20）；更改后直接截取已有完整排名，不会重新扫描。"
                            Value="{Binding TopN, Mode=TwoWay}"/>
          <TextBlock Text=" 只（完整候选池仍保留并导出）" VerticalAlignment="Center" Foreground="DimGray"/>
        </StackPanel>

        <TextBlock Text="{Binding ResultSummary}" Foreground="SteelBlue" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="{Binding CurrentPresetName}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="恢复推荐默认" Padding="12,4,12,4" Command="{Binding ResetRecommendedDefaultsCommand}"/>
        </StackPanel>

        <Expander Header="高级 / 系统设置" IsExpanded="False">
          <StackPanel>
            <WrapPanel>
              <CheckBox x:Name="ChkUseCache" Content="使用缓存" ToolTip="运行时数据缓存设置，不改变选股规则。" Margin="0,0,15,10"
                        IsChecked="{Binding SystemSettings.UseCache, Mode=TwoWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,15,10" ToolTip="网络并发数，只影响执行速度，不改变选股质量。">
                <TextBlock Text="并发数：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown x:Name="NumConcurrency" Minimum="1" Maximum="32" Width="65"
                                  Value="{Binding SystemSettings.MaxConcurrency, Mode=TwoWay}"/>
              </StackPanel>
              <CheckBox x:Name="ChkAutoScan" Content="盘中自动扫描（14:00-14:50 每 5 分钟）" ToolTip="工作日盘中定时以当前模式扫描，新晋 Top N 标的通过 Growl 提醒；不影响手动扫描。" Margin="0,0,15,10"
                        IsChecked="{Binding SystemSettings.AutoScanEnabled, Mode=TwoWay}"/>
            </WrapPanel>
            <TextBlock Text="自动扫描仅在窗口内触发；完成后的新晋标的（相对上一次 Top N）逐只提醒，最多点名 5 只。" Foreground="Gray" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="12,0,12,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtProgressDesc" VerticalAlignment="Center"/>
        <ProgressBar x:Name="PbScan" Grid.Column="1" Height="18" Margin="8,0" VerticalAlignment="Center"
                     Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"/>
        <TextBlock x:Name="TxtStats" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button x:Name="BtnStart" Content="{Binding StartButtonText}" MinWidth="96" Margin="0,0,8,0" Command="{Binding StartCommand}"/>
          <Button Content="停止扫描" Margin="0,0,8,0" Command="{Binding CancelScanCommand}"/>
          <Button x:Name="BtnTest" Content="自检" MinWidth="72" Command="{Binding TestCommand}"/>
        </StackPanel>
      </Grid>
      <TabControl Grid.Row="1">
        <TabItem Header="运行日志">
          <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                   Text="{Binding LogText}" FontFamily="Consolas"/>
        </TabItem>
        <TabItem Header="选股结果">
          <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                    RowHeaderWidth="0" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="排名" Binding="{Binding DisplayRank}" Width="46"/>
              <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="78"/>
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
              <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90"/>
              <DataGridTextColumn Header="左策略" Binding="{Binding LeftVersion}" Width="80"/>
              <DataGridTextColumn Header="右策略" Binding="{Binding RightVersion}" Width="80"/>
              <DataGridTextColumn Header="评分" Binding="{Binding DisplayScore, StringFormat=F1}" Width="62"/>
              <DataGridTextColumn Header="涨幅%" Binding="{Binding RisePercent, StringFormat=F2}" Width="66"/>
              <DataGridTextColumn Header="成交额(万)" Binding="{Binding AmountWan, StringFormat=F0}" Width="88"/>
              <DataGridTextColumn Header="买压比" Binding="{Binding BuyPressureRatio, StringFormat=F2}" Width="66"/>
              <DataGridTextColumn Header="黏合%" Binding="{Binding AdhesionPercent, StringFormat=F2}" Width="62"/>
              <DataGridTextColumn Header="换手%" Binding="{Binding Turnover, StringFormat=F1}" Width="58"/>
              <DataGridTextColumn Header="动量%" Binding="{Binding MomentumPercent, StringFormat=F4}" Width="66"/>
              <DataGridTextColumn Header="Alpha" Binding="{Binding AlphaMargin, StringFormat=F2}" Width="58"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</hc:Window>
