<Window x:Class="AIHelper.Views.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据导入导出" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="导入导出股票列表" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
        
        <TextBox x:Name="TxtData" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 hc:InfoElement.Placeholder="在此粘贴导入的股票数据，或在此查看导出的股票数据..."/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10">
            <RadioButton x:Name="RbAllTabs" Content="所有打勾股票" Margin="0,0,15,0" IsChecked="True"/>
            <RadioButton x:Name="RbCurrentTab" Content="当前分组股票"/>
        </StackPanel>
        
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Text="准备就绪" VerticalAlignment="Center" Foreground="Gray"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="导出" Click="BtnExport_Click" Style="{StaticResource ButtonPrimary}" Margin="0,0,10,0"/>
                <Button Content="复制内容" Click="BtnCopy_Click" Style="{StaticResource ButtonInfo}" Margin="0,0,10,0"/>
                <Button Content="导入" Click="BtnImport_Click" Style="{StaticResource ButtonSuccess}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
