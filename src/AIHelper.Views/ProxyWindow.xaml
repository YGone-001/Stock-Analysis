<hc:Window x:Class="AIHelper.Views.ProxyWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="代理设置" Height="380" Width="450"
           WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="网络代理配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>
        
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="启用代理:" VerticalAlignment="Center"/>
            <ToggleButton x:Name="TglEnableProxy" Grid.Column="1" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Left"/>
        </Grid>
        
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="代理地址:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtAddress" Grid.Column="1" hc:InfoElement.Placeholder="例: 127.0.0.1 或 http://proxy..."/>
        </Grid>
        
        <Grid Grid.Row="3" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="端口:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPort" Grid.Column="1" hc:InfoElement.Placeholder="例: 1080"/>
        </Grid>
        
        <Grid Grid.Row="4" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="用户名 (可选):" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUsername" Grid.Column="1" hc:InfoElement.Placeholder="代理用户名"/>
        </Grid>
        
        <Grid Grid.Row="5" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="密码 (可选):" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtPassword" Grid.Column="1" hc:InfoElement.Placeholder="代理密码"/>
        </Grid>
        
        <TextBlock x:Name="TxtTestResult" Grid.Row="6" Margin="0,15,0,0" TextWrapping="Wrap" Foreground="Gray"/>
        
        <Grid Grid.Row="7" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="BtnTest" Content="测试连接" Click="BtnTest_Click" Style="{StaticResource ButtonInfo}"/>
            
            <Button x:Name="BtnCancel" Grid.Column="2" Content="取消" Click="BtnCancel_Click" Margin="0,0,10,0" Width="80"/>
            <Button x:Name="BtnSave" Grid.Column="3" Content="保存" Click="BtnSave_Click" Style="{StaticResource ButtonPrimary}" Width="80"/>
        </Grid>
    </Grid>
</hc:Window>
