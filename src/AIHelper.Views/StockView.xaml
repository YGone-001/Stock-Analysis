<UserControl x:Class="AIHelper.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:models="clr-namespace:AIHelper.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="5" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <WrapPanel VerticalAlignment="Center">
                <TextBox x:Name="TxtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="150" hc:InfoElement.Placeholder="搜索股票代码或拼音..." Margin="0,0,10,0"/>
                
                <Popup IsOpen="{Binding IsSearchPopupOpen}" PlacementTarget="{Binding ElementName=TxtSearch}" StaysOpen="False">
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" MaxHeight="200" MinWidth="150">
                        <ListBox ItemsSource="{Binding SearchResults}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Code}" Width="60"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <TextBox x:Name="TxtNewGroup" Width="150" hc:InfoElement.Placeholder="新分组名称..." Margin="0,0,5,0"/>
                <Button Content="添加分组" Command="{Binding AddGroupCommand}" CommandParameter="{Binding ElementName=TxtNewGroup, Path=Text}" Margin="0,0,10,0"/>
                
                <CheckBox Content="全选" IsChecked="{Binding IsAllStocksSelected}" Margin="10,0,0,0"/>
            </WrapPanel>
        </Border>
        
        <!-- Main Content: Tabs -->
        <TabControl Grid.Row="1" ItemsSource="{Binding StockGroups}" SelectedItem="{Binding SelectedGroup}" Margin="0,5,0,0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid ItemsSource="{Binding Stocks}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Header="选择" Width="60"/>
                            <DataGridTextColumn Binding="{Binding Code}" Header="代码" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="名称" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Binding="{Binding Price}" Header="最新价" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Binding="{Binding ChangePercent, StringFormat={}{0:F2}%}" Header="涨跌幅" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Binding="{Binding TurnoverRate, StringFormat={}{0:F2}%}" Header="换手率" IsReadOnly="True" Width="80"/>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="删除" Command="{Binding DataContext.DeleteStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Style="{StaticResource ButtonDanger}" Margin="0,0,5,0"/>
                                            <Button Content="移动" Click="BtnMove_Click" Style="{StaticResource ButtonPrimary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
