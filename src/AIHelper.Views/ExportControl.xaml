<UserControl x:Class="AIHelper.Views.ExportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="数据导出 &amp; 采集面板" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
            
            <!-- General Settings -->
            <GroupBox Header="全局设置" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标日期:" VerticalAlignment="Center"/>
                        <DatePicker x:Name="DpTargetDate" Grid.Column="1" Width="150" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出格式:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="RdoSingleFile" Content="单文件合并" Margin="0,0,15,0" IsChecked="True"/>
                            <RadioButton x:Name="RdoMultiFile" Content="多文件分离"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AI 辅助:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleAiCompress" Content="内容压缩" Style="{StaticResource ToggleButtonSwitch}" Margin="0,0,15,0"/>
                            <ToggleButton x:Name="ToggleHoldingPrompt" Content="持仓提示" Style="{StaticResource ToggleButtonSwitch}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Basic Data Fetch -->
            <GroupBox Header="独立数据采集 (当前分组)" Margin="0,0,0,10">
                <WrapPanel>
                    <Button x:Name="BtnFetchQuote" Content="获取盘面报价" Margin="0,0,10,10" Style="{StaticResource ButtonPrimary}"/>
                    <Button x:Name="BtnFetchMinute" Content="获取分时图" Margin="0,0,10,10" Style="{StaticResource ButtonInfo}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,10">
                        <Button x:Name="BtnFetchKline" Content="获取K线" Style="{StaticResource ButtonSuccess}"/>
                        <TextBlock Text=" 天数:" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox x:Name="TxtKlineDays" Text="30" Width="50"/>
                    </StackPanel>
                    <Button x:Name="BtnFetchTick" Content="获取逐笔交易" Margin="0,0,10,10" Style="{StaticResource ButtonWarning}"/>
                </WrapPanel>
            </GroupBox>

            <!-- Composite Data Fetch -->
            <GroupBox Header="组合数据采集" Margin="0,0,0,10">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkComboQuote" Content="盘面报价" Margin="0,0,10,0" IsChecked="True"/>
                        <CheckBox x:Name="ChkComboMinute" Content="分时图" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkComboKline" Content="K线数据" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkComboTick" Content="逐笔交易" Margin="0,0,10,0"/>
                    </WrapPanel>
                    
                    <Button x:Name="BtnFetchComposite" Content="一键采集选中数据" HorizontalAlignment="Left" Style="{StaticResource ButtonDanger}"/>
                </StackPanel>
            </GroupBox>

            <!-- Index Settings -->
            <GroupBox Header="指数附加数据 (可选)" Margin="0,0,0,10">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkIdxSH" Content="上证指数 (000001)" Margin="0,0,10,0" IsChecked="True"/>
                        <CheckBox x:Name="ChkIdxSZ" Content="深证成指 (399001)" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkIdxCY" Content="创业板指 (399006)" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkIdxHS300" Content="沪深300 (000300)" Margin="0,0,10,0"/>
                    </WrapPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="指数对比天数:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtIndexDays" Text="5" Width="50"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
