<Window x:Class="AIHelper.Views.PositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置持仓" Height="250" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TxtTitle" Text="设置持仓 - 股票" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>
        
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="持仓数量:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtVolume" Grid.Column="1" hc:InfoElement.Placeholder="请输入数量(股)"/>
        </Grid>
        
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="成本均价:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCostPrice" Grid.Column="1" hc:InfoElement.Placeholder="请输入成本价"/>
        </Grid>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Click="BtnCancel_Click" Margin="0,0,10,0" Width="80"/>
            <Button Content="保存" Click="BtnSave_Click" Style="{StaticResource ButtonPrimary}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
