<UserControl x:Class="AIHelper.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="Bool2Vis"/>

        <Style x:Key="MessageItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,5">
                <!-- System message -->
                <Border Visibility="{Binding IsSystem, Converter={StaticResource Bool2Vis}}" HorizontalAlignment="Center" Background="#E0E0E0" CornerRadius="10" Padding="10,2">
                    <TextBlock Text="{Binding Content}" FontSize="12" Foreground="Gray"/>
                </Border>

                <!-- Normal message -->
                <Grid Visibility="{Binding IsSystem, Converter={StaticResource Bool2Vis}, ConverterParameter=Invert}">
                    <!-- Different layout based on IsSelf using DataTrigger -->
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- Left aligned by default -->
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel x:Name="MsgStack" Orientation="Horizontal">
                        <!-- Avatar -->
                        <Grid x:Name="AvatarGrid" Width="40" Height="40" VerticalAlignment="Top" MouseLeftButtonDown="MyAvatar_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,10,0">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding LocalAvatarPath}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- Content -->
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{Binding HeaderText}" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            
                            <!-- Bubble -->
                            <Border x:Name="Bubble" Background="#F1F1F1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxWidth="300" Visibility="{Binding IsText, Converter={StaticResource Bool2Vis}}"/>
                                    <Image Source="{Binding ImageSource}" MouseLeftButtonDown="ChatImage_MouseLeftButtonDown" Cursor="Hand" MaxWidth="250" MaxHeight="250" Visibility="{Binding IsImage, Converter={StaticResource Bool2Vis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <!-- IsSelf -> Reverse order -->
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <!-- Move Avatar to right by changing FlowDirection or explicitly manipulating layout -->
                    <!-- Simpler: change FlowDirection of StackPanel -->
                    <Setter TargetName="MsgStack" Property="FlowDirection" Value="RightToLeft"/>
                    <Setter TargetName="AvatarGrid" Property="Margin" Value="10,0,0,0"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter TargetName="Bubble" Property="TextBlock.Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ChatMainUI">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="10">
                <Grid>
                    <TextBlock Text="AI 助手 - 团队交流" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="退出登录" HorizontalAlignment="Right" Click="BtnLogout_Click" Style="{StaticResource ButtonDanger}"/>
                </Grid>
            </Border>

            <!-- Messages List -->
            <ListBox x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" 
                     ItemContainerStyle="{StaticResource MessageItemStyle}" 
                     ItemTemplate="{StaticResource MessageTemplate}"
                     HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

            <!-- Input Area -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="BtnEmoji" Grid.Column="0" Content="😊" Click="BtnEmoji_Click" 
                            Style="{StaticResource ButtonIcon}" Margin="0,0,10,0" Width="30" Height="30" VerticalAlignment="Bottom"/>
                    
                    <TextBox x:Name="TxtInput" Grid.Column="1" PreviewKeyDown="TxtInput_PreviewKeyDown" 
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" MinHeight="35"
                             hc:InfoElement.Placeholder="Enter 发送消息, Ctrl+Enter 换行" 
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Popups -->
        <Popup x:Name="EmojiPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnEmoji}" Placement="Top">
            <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="5">
                <ItemsControl ItemsSource="{Binding Emojis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel MaxWidth="250"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MouseLeftButtonDown="LocalEmoji_Click" Padding="5" Cursor="Hand">
                                <Image Source="{Binding}" Width="32" Height="32"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>

        <Popup x:Name="AvatarPickerPopup" StaysOpen="False" Placement="MousePoint">
            <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="选择头像" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="AvatarItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="200"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MouseLeftButtonDown="SelectLocalAvatar_Click" Padding="2" Cursor="Hand" Tag="{Binding}">
                                    <Image Source="{Binding}" Width="48" Height="48"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border MouseLeftButtonDown="ResetGravatar_Click" Background="#EEEEEE" Padding="5" Margin="0,10,0,0" CornerRadius="4" Cursor="Hand">
                        <TextBlock Text="恢复默认头像" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Login Overlay -->
        <Border x:Name="LoginOverlay" Visibility="Collapsed" Background="#CCFFFFFF">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="未登录聊天系统" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <Button Content="去登录" Click="BtnShowLogin_Click" Style="{StaticResource ButtonPrimary}" Width="120"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
