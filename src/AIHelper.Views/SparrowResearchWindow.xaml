<Window x:Class="AIHelper.Views.SparrowResearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="麻雀研究 · 历史回放 / 回测" Width="1180" Height="780" MinWidth="900" MinHeight="620">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="研究回测 / 选股研究" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="历史分析仅使用收盘价对收盘价计算。实时数据源状态只用于可观测性展示，不会改变历史回放的取数路径。" Opacity="0.72" TextWrapping="Wrap" Margin="0,4,0,10"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#D0D5DD" BorderThickness="1" Padding="10" Margin="0,4,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="历史数据集" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DatasetDisplayName}"/><TextBlock Text="{Binding DatasetStatus}" TextWrapping="Wrap" Opacity="0.75"/>
          <TextBlock Text="{Binding DatasetSummary}" TextWrapping="Wrap" Opacity="0.75"/>
          <TextBlock Text="{Binding DatasetSchema, StringFormat=数据模式：{0}}" Opacity="0.75"/>
          <TextBlock Text="{Binding UniverseQuality, StringFormat=股票池质量：{0}}" Opacity="0.75"/>
          <TextBlock Text="{Binding LifecycleQuality, StringFormat=生命周期质量：{0}}" TextWrapping="Wrap" Opacity="0.75"/>
          <TextBlock Text="{Binding DataQualityWarning}" TextWrapping="Wrap" Foreground="DarkOrange"/>
          <TextBlock Text="{Binding CapabilitiesSummary}" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>
        <Button x:Name="LoadDatasetButton" Grid.Column="1" Content="加载数据集" Command="{Binding LoadDatasetCommand}" MinWidth="112" Margin="12,0,0,0" VerticalAlignment="Top"/>
      </Grid>
    </Border>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <TextBlock Text="策略" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox ItemsSource="{Binding SupportedStrategies}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Strategy}" Width="120" Margin="0,0,8,0"/>
      <TextBlock Text="版本" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="{Binding StrategyVersionDisplay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <TextBlock Text="回放日期" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker SelectedDate="{Binding ReplayDate}" Width="130" Margin="0,0,14,0"/>
      <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker SelectedDate="{Binding StartDate}" Width="130" Margin="0,0,14,0"/>
      <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker SelectedDate="{Binding EndDate}" Width="130" Margin="0,0,14,0"/>
      <TextBlock Text="选股数量(Top-N)" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding TopN, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="0,0,14,0"/>
      <TextBlock Text="双边总成本(%)" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding RoundTripCostPercent, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="0,0,14,0"/>
      <TextBlock Text="单边滑点(%)" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding SlippagePerSidePercent, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="0,0,14,0"/>
      <Button x:Name="RunReplayButton" Content="运行回放" Command="{Binding RunReplayCommand}" Margin="0,0,6,0"/><Button x:Name="RunBacktestButton" Content="运行回测" Command="{Binding RunBacktestCommand}" Margin="0,0,6,0"/><Button x:Name="CancelButton" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,6,0"/>
      <Button x:Name="SaveReplayButton" Content="保存回放结果" Command="{Binding ExportReplayCommand}" Margin="0,0,6,0"/><Button x:Name="SaveBacktestButton" Content="保存回测结果" Command="{Binding ExportBacktestCommand}"/>
    </WrapPanel>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding StrategySupportMessage}" TextWrapping="Wrap" Foreground="#465362"/>
      <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="持有天数" Binding="{Binding Horizon}"/><DataGridTextColumn Header="可用样本" Binding="{Binding Available}"/><DataGridTextColumn Header="平均收益" Binding="{Binding Average}"/><DataGridTextColumn Header="收益中位数" Binding="{Binding Median}"/><DataGridTextColumn Header="胜率" Binding="{Binding WinRate}"/></DataGrid.Columns></DataGrid>
        <DataGrid Grid.Column="1" ItemsSource="{Binding ProviderHealth}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" Margin="10,0,0,0"><DataGrid.Columns><DataGridTextColumn Header="实时数据源" Binding="{Binding Provider}"/><DataGridTextColumn Header="状态" Binding="{Binding State}"/><DataGridTextColumn Header="延迟" Binding="{Binding LastLatency}"/><DataGridTextColumn Header="最近活动" Binding="{Binding LastActivity}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid>
      <DataGrid Grid.Row="3" ItemsSource="{Binding Selections}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="回放日期" Binding="{Binding Date}"/><DataGridTextColumn Header="代码" Binding="{Binding Code}"/><DataGridTextColumn Header="排名" Binding="{Binding Rank}"/><DataGridTextColumn Header="评分" Binding="{Binding Score}"/><DataGridTextColumn Header="原因代码" Binding="{Binding ReasonCode}"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="1日" Binding="{Binding Return1D}"/><DataGridTextColumn Header="3日" Binding="{Binding Return3D}"/><DataGridTextColumn Header="5日" Binding="{Binding Return5D}"/><DataGridTextColumn Header="10日" Binding="{Binding Return10D}"/><DataGridTextColumn Header="20日" Binding="{Binding Return20D}"/></DataGrid.Columns></DataGrid>
    </Grid>
    <Expander Grid.Row="4" Header="组合模拟（收盘价对收盘价 · 等权 · 零成本 · 5 日持有）" Margin="0,12,0,0" IsExpanded="False">
      <StackPanel Margin="8">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="运行组合模拟" Command="{Binding RunPortfolioSimulationCommand}" MinWidth="112"/>
          <TextBlock Text="{Binding PortfolioSummary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#465362"/>
        </StackPanel>
        <TextBlock Text="组合净值（与回放同数据集同参数）" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <lvc:CartesianChart Series="{Binding EquitySeries}" Height="180"/>
        <TextBlock Text="回撤（水下曲线，%点）" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <lvc:CartesianChart Series="{Binding DrawdownSeries}" Height="140"/>
      </StackPanel>
    </Expander>
    <Expander Grid.Row="5" Header="数据局限" Margin="0,12,0,0"><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" Margin="8"/></Expander>
  </Grid>
</Window>
