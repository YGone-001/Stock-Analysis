<Window x:Class="AIHelper.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#CC000000" WindowStyle="None" AllowsTransparency="True">
    
    <Grid>
        <TextBlock Text="双击关闭，滚轮缩放，拖拽移动" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Opacity="0.7"/>
        
        <Border x:Name="ImageContainer" Background="Transparent" 
                MouseDown="Container_MouseDown"
                MouseWheel="Container_MouseWheel"
                MouseLeftButtonDown="Container_MouseLeftButtonDown"
                MouseMove="Container_MouseMove"
                MouseLeftButtonUp="Container_MouseLeftButtonUp">
            
            <Image x:Name="MainImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <MatrixTransform x:Name="ImgTransform"/>
                </Image.RenderTransform>
            </Image>
        </Border>
    </Grid>
</Window>
